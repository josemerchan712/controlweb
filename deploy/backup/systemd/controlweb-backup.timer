# Daily encrypted backup at 04:15 UTC, after the Rotten Odds backup (03:30 UTC plus up to 10 minutes) and after the nightly purge of old
# checks of ControlWeb (app.retention.cron, 03:30), so a copy never races with a purge. Persistent: if the server was off at 04:15 the
# backup runs as soon as it is on again.
[Unit]
Description=Daily encrypted backup of the ControlWeb database

[Timer]
OnCalendar=*-*-* 04:15:00 UTC
Persistent=true
AccuracySec=1min
Unit=controlweb-backup.service

[Install]
WantedBy=timers.target
