# Template for /opt/controlweb/.env.prod on the server (owner root, group jose, mode 640). NEVER commit the real file.
# Generate every secret ON THE SERVER, different from the ones you use locally:
#   openssl rand -base64 32      (JWT_SECRET: at least 32 random bytes in Base64)
#   openssl rand -base64 18      (ADMIN_PASSWORD, DB_PASSWORD)
# The production profile refuses to start with an empty value, an example value like these, or a looser setting than
# production allows (see docs/DESPLIEGUE.md). The empty values below are on purpose: fill them in.

# --- database (its own PostgreSQL, on a private network) ---
DB_NAME=controlweb
DB_USERNAME=controlweb
DB_PASSWORD=

# --- authentication ---
JWT_SECRET=
JWT_TTL_MINUTES=60
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- behind Caddy ---
# The FIXED IP of Caddy in the shared network controlweb_proxy (exact IP, no ranges or names).
TRUSTED_PROXY_ADDRESSES=10.77.0.10
# The exact origin of the portfolio that may read /api/public/status from a browser (https, no localhost).
PUBLIC_CORS_ALLOWED_ORIGINS=
# Origin(s) of the future dashboard; empty = none.
CORS_ALLOWED_ORIGINS=

# --- alerts (optional): a NEW bot, different from the local one, and the same chat ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- external heartbeat (optional): the secret ping URL of the external monitor, https only ---
HEARTBEAT_URL=

# --- history kept, in days (minimum 30) ---
RETENTION_DAYS=90

# --- release tag of the image to run; the deploy script sets it ---
# CONTROLWEB_TAG=current
