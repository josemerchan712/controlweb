# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database ---
DB_NAME=controlweb
DB_USERNAME=controlweb
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/controlweb

# --- Auth (REQUIRED: the app will not start without valid values) ---
# JWT_SECRET: Base64 of at least 32 random bytes. Generate one in PowerShell with:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_TTL_MINUTES=60
# The single panel administrator, created/updated at startup.
ADMIN_EMAIL=admin@example.com
# At least 12 characters (and at most 72 bytes).
ADMIN_PASSWORD=

# --- Telegram alerts (optional) ---
# BOTH variables are needed to send alerts to Telegram. With only one of them (or none) the app still starts,
# warns clearly (never printing values) and just writes the alerts to the log.
# 1) Create a bot with @BotFather in Telegram and copy its token (looks like 123456789:AAF...). It is a SECRET.
# 2) Send any message to your bot, then open https://api.telegram.org/bot<YOUR_TOKEN>/getUpdates in a browser and
#    read "chat":{"id": ...}. A group or channel id is negative (-100...); a public channel can be @channelname.
# 3) Check it works with POST /api/alerts/test (needs your JWT; one call every 10 seconds at most).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Public status page: GET /api/public/status (the only endpoint without a token) ---
# Exact origins allowed to read it from a browser, normally your portfolio: PUBLIC_CORS_ALLOWED_ORIGINS=https://my-portfolio.example.com
# No wildcard, no path (the app refuses to start otherwise). Empty = no browser access to it. It is separate from
# CORS_ALLOWED_ORIGINS below, which is for the private dashboard.
PUBLIC_CORS_ALLOWED_ORIGINS=

# --- CORS (private API / dashboard) ---
# Comma separated exact origins (scheme://host[:port]); wildcards are rejected. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:5173
