# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database ---
DB_NAME=controlweb
DB_USERNAME=controlweb
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/controlweb

# --- Auth (REQUIRED: the app will not start without valid values) ---
# JWT_SECRET: Base64 of at least 32 random bytes. Generate one in PowerShell with:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
JWT_SECRET=
JWT_TTL_MINUTES=60
# The single panel administrator, created/updated at startup.
ADMIN_EMAIL=admin@example.com
# At least 12 characters (and at most 72 bytes).
ADMIN_PASSWORD=

# --- Telegram alerts (used from step 7; optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CORS ---
# Comma separated exact origins (scheme://host[:port]); wildcards are rejected. Empty = no cross-origin access.
CORS_ALLOWED_ORIGINS=http://localhost:5173
