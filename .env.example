# Copy this file to .env and fill in real values. NEVER commit .env.

# --- Database ---
DB_NAME=controlweb
DB_USERNAME=controlweb
DB_PASSWORD=change-me
DB_URL=jdbc:postgresql://localhost:5432/controlweb

# --- Auth (used from step 3) ---
# Base64 secret of at least 32 bytes, e.g. generate with: openssl rand -base64 32
JWT_SECRET=
JWT_TTL_MINUTES=60
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

# --- Telegram alerts (used from step 7; optional) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
